# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# GitHub Actions ephemeral self-hosted runner
# Alpine base + Podman-in-Docker (Docker Engine replaced by Podman), multi-arch
# (linux/amd64, linux/arm64)
#
# EXPERIMENTAL, derived from Dockerfile.alpine: same musl-built actions/runner
# (see patches/actions-runner-musl-support.patch and README.md's
# "Compatibility note"), but replaces the Docker Engine stack
# (docker-engine + containerd + docker-cli + docker-cli-buildx + runc, ~270MB)
# with Podman + the podman-docker CLI shim (~89MB) to test whether dropping
# Docker entirely shrinks the image further. `docker` commands issued by
# workflow steps or by register-and-run.sh keep working unmodified because
# `podman-docker` installs a `/usr/bin/docker` shim that forwards to `podman`.
#
# Two Alpine-specific config tweaks are required for nested
# (--privileged-in---privileged) container execution to work at all — neither
# is needed on a "normal" (non-nested) Podman host:
#   1. /etc/containers/storage.conf: driver = "vfs" instead of the default
#      "overlay" — identical rationale to the dockerd `--storage-driver=vfs`
#      flag already used for DinD (overlay-on-overlay is unsupported).
#   2. /etc/containers/containers.conf: cgroup_manager = "cgroupfs" instead of
#      the default "systemd" — Alpine has no systemd, so the default silently
#      breaks cgroup delegation for nested containers (crun/runc error:
#      "the requested cgroup controller `pids` is not available").
# A one-time harmless warning ("Failed to add conmon to cgroupfs sandbox
# cgroup...") is expected on the very first Podman container ever started in
# a given container instance (Podman lazily creates its `/libpod_parent`
# cgroup on first use); entrypoint-podman.sh primes this once at startup so
# it never surfaces during an actual workflow job.
# ---------------------------------------------------------------------------
ARG ALPINE_VERSION=3.20
ARG DOTNET_SDK_VERSION=8.0
ARG RUNNER_VERSION=2.335.1

# --- Builder: compile actions/runner from source for linux-musl-{x64,arm64} ---
# Identical to Dockerfile.alpine's builder stage; the runner binary itself has
# no dependency on Docker vs Podman.
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION}-alpine AS builder

ARG RUNNER_VERSION
ARG TARGETARCH
ARG INCLUDE_NODE20=false

RUN apk add --no-cache bash git icu-libs curl

WORKDIR /work

RUN git clone --depth 1 --branch "v${RUNNER_VERSION}" \
        https://github.com/actions/runner.git runner-src \
    && git config --global --add safe.directory /work/runner-src

COPY patches/actions-runner-musl-support.patch /tmp/actions-runner-musl-support.patch
RUN cd runner-src && git apply /tmp/actions-runner-musl-support.patch

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) MUSL_RID="linux-musl-x64" ;; \
        arm64) MUSL_RID="linux-musl-arm64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd runner-src/src \
    && ./dev.sh layout Release "${MUSL_RID}"

RUN if [ "${INCLUDE_NODE20}" != "true" ]; then \
        echo "Dropping bundled node20 (set --build-arg INCLUDE_NODE20=true to keep it)"; \
        rm -rf /work/runner-src/_layout/externals/node20; \
    fi

# --- Final: Alpine runtime image ------------------------------------------
FROM alpine:${ALPINE_VERSION}

ARG RUNNER_VERSION
ARG TARGETARCH

LABEL org.opencontainers.image.title="github-actions-runner-alpine-podman" \
      org.opencontainers.image.description="Ephemeral, GitHub App-authenticated self-hosted GitHub Actions runner with Podman-in-Docker (Docker replaced by Podman), on Alpine (amd64/arm64), using a source-built musl runner binary." \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/OWNER/github-actions-runner"

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    LC_ALL=C.UTF-8

# --- Base OS deps -------------------------------------------------------------
# Same base tool list as Dockerfile.alpine (see that file's comment for the
# libstdc++/libgcc/icu-libs rationale). `gnupg` intentionally omitted for the
# same reason as Dockerfile.alpine.
RUN apk add --no-cache \
        bash \
        curl \
        jq \
        git \
        openssh-client \
        openssl \
        ca-certificates \
        tar \
        gzip \
        sudo \
        util-linux \
        libstdc++ \
        libgcc \
        icu-libs \
        shadow

# --- Podman (replaces Docker Engine) ------------------------------------------
# `podman` is the engine; `podman-docker` installs a `/usr/bin/docker` shim
# script that forwards to `podman`, so existing `docker ...` invocations in
# workflow steps and register-and-run.sh keep working unmodified.
# `shadow-uidmap` provides newuidmap/newgidmap, needed for user-namespace
# handling even in this rootful/--privileged setup.
RUN apk add --no-cache \
        podman \
        podman-docker \
        shadow-uidmap \
    && sed -i 's/^driver = "overlay"/driver = "vfs"/' /etc/containers/storage.conf \
    && sed -i 's/^#cgroup_manager = "systemd"/cgroup_manager = "cgroupfs"/' /etc/containers/containers.conf \
    && mkdir -p /etc/containers \
    && touch /etc/containers/nodocker

# --- Non-root runner user ------------------------------------------------------
# actions/runner refuses to run config.sh/run.sh as root, so the registration
# and job-execution steps run as this user. Unlike Dockerfile.alpine, there is
# no background daemon to keep running as root: Podman is daemonless (each
# `podman`/`docker` invocation forks its own short-lived process), so
# entrypoint-podman.sh can `exec` straight into the runner user without a
# trap/cleanup step. Passwordless sudo is granted for parity with the Ubuntu
# and Docker-Alpine images.
RUN addgroup docker 2>/dev/null || true \
    && adduser -D -h /home/runner -s /bin/bash runner \
    && addgroup runner docker \
    && echo "runner ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Podman auto-detects rootless mode whenever it's invoked by a non-root user
# (true here: actions/runner refuses to run as root, so job steps — and any
# `docker`/`podman` command they issue — execute as `runner`). Rootless
# Podman requires a subordinate UID/GID range for that user to build its user
# namespace; without this it fails with "no subuid ranges found for user
# ... in /etc/subuid". `shadow-uidmap` (installed above) provides the
# newuidmap/newgidmap helpers rootless mode needs to apply this range.
RUN echo "runner:100000:65536" >> /etc/subuid \
    && echo "runner:100000:65536" >> /etc/subgid

# --- Copy the musl-built actions/runner layout from the builder stage ---------
COPY --from=builder --chown=runner:runner /work/runner-src/_layout /home/runner/actions-runner

WORKDIR /home/runner/actions-runner

COPY --chmod=0755 entrypoint-podman.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 scripts/generate-installation-token.sh /usr/local/bin/generate-installation-token.sh
COPY --chmod=0755 scripts/register-and-run.sh /usr/local/bin/register-and-run.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f Runner.Listener >/dev/null 2>&1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
