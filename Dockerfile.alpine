# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# GitHub Actions ephemeral self-hosted runner
# Alpine base + Docker-in-Docker, multi-arch (linux/amd64, linux/arm64)
#
# EXPERIMENTAL: unlike the Ubuntu image (see Dockerfile), this does NOT use
# the official actions/runner release tarball — that binary is a glibc/.NET
# build that crashes on musl (see the "Compatibility note" in README.md and
# actions/runner#585). Instead, this build compiles actions/runner from
# source with linux-musl-x64/linux-musl-arm64 added as Runtime Identifiers
# (patches/actions-runner-musl-support.patch), producing a genuinely
# musl-linked, self-contained runner binary. Verified working (config.sh,
# run.sh, Runner.Listener) on plain Alpine 3.20 with only libstdc++ and
# icu-libs installed — no gcompat/glibc shim needed. See
# patches/README.md for exactly what the patch changes and why.
# ---------------------------------------------------------------------------
ARG ALPINE_VERSION=3.20
ARG DOTNET_SDK_VERSION=8.0
ARG RUNNER_VERSION=2.335.1

# --- Builder: compile actions/runner from source for linux-musl-{x64,arm64} ---
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION}-alpine AS builder

ARG RUNNER_VERSION
ARG TARGETARCH
# Node 20 is deprecated for GitHub Actions (JS actions now default to Node 24
# as of June 2026; Node 20 is fully removed in September 2026) and this
# image's own end-to-end test confirmed the platform already forces Node 24
# by default regardless of what an action.yml declares. The bundled node20
# binary (~100MB, musl-static) is therefore unused in the common case, so it
# is dropped by default to shrink the image. Set INCLUDE_NODE20=true to keep
# it if you still rely on ACTIONS_ALLOW_USE_UNSECURE_NODE_VERSION=true to
# opt back into Node 20 for legacy actions during the transition window.
ARG INCLUDE_NODE20=false

RUN apk add --no-cache bash git icu-libs curl

WORKDIR /work

RUN git clone --depth 1 --branch "v${RUNNER_VERSION}" \
        https://github.com/actions/runner.git runner-src \
    && git config --global --add safe.directory /work/runner-src

COPY patches/actions-runner-musl-support.patch /tmp/actions-runner-musl-support.patch
RUN cd runner-src && git apply /tmp/actions-runner-musl-support.patch

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) MUSL_RID="linux-musl-x64" ;; \
        arm64) MUSL_RID="linux-musl-arm64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd runner-src/src \
    && ./dev.sh layout Release "${MUSL_RID}"

RUN if [ "${INCLUDE_NODE20}" != "true" ]; then \
        echo "Dropping bundled node20 (set --build-arg INCLUDE_NODE20=true to keep it)"; \
        rm -rf /work/runner-src/_layout/externals/node20; \
    fi

# --- Final: Alpine runtime image ------------------------------------------
FROM alpine:${ALPINE_VERSION}

ARG RUNNER_VERSION
ARG TARGETARCH

LABEL org.opencontainers.image.title="github-actions-runner-alpine" \
      org.opencontainers.image.description="Ephemeral, GitHub App-authenticated self-hosted GitHub Actions runner with Docker-in-Docker, on Alpine (amd64/arm64), using a source-built musl runner binary." \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/OWNER/github-actions-runner"

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    LC_ALL=C.UTF-8

# --- Base OS deps -------------------------------------------------------------
# libstdc++/libgcc + icu-libs are the only extra runtime libs the
# musl-built Runner.Listener needs (confirmed via `ldd`); everything else
# here mirrors the tool list installed on the Ubuntu image. `gnupg` is
# intentionally NOT installed here: on Ubuntu it's only needed to import
# Docker's apt repo signing key, but this image installs Docker via `apk`
# (no GPG key import step), so it would be dead weight.
RUN apk add --no-cache \
        bash \
        curl \
        jq \
        git \
        openssh-client \
        openssl \
        ca-certificates \
        tar \
        gzip \
        sudo \
        util-linux \
        libstdc++ \
        libgcc \
        icu-libs \
        shadow

# --- Docker Engine (for Docker-in-Docker) --------------------------------------
# Docker has no official Alpine apt-style repo; the `docker`/`docker-cli`/
# `docker-cli-buildx` packages are available directly from Alpine's own
# community repo and are what this image uses. Verified: dockerd starts
# under --privileged and a nested `docker build` succeeds (same `vfs`
# storage-driver default/rationale as the Ubuntu image — see
# entrypoint.sh and the Docker-in-Docker storage driver note in README.md).
RUN apk add --no-cache \
        docker \
        docker-cli-buildx

# --- Non-root runner user ------------------------------------------------------
# actions/runner refuses to run config.sh/run.sh as root, so the registration
# and job-execution steps run as this user (entrypoint.sh switches to it via
# `runuser` after starting dockerd as root). Passwordless sudo is granted so
# workflow steps can install packages, matching common self-hosted runner
# conventions (e.g. GitHub-hosted runners also grant the runner passwordless
# sudo).
RUN addgroup docker 2>/dev/null || true \
    && adduser -D -h /home/runner -s /bin/bash runner \
    && addgroup runner docker \
    && echo "runner ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# --- Copy the musl-built actions/runner layout from the builder stage ---------
COPY --from=builder --chown=runner:runner /work/runner-src/_layout /home/runner/actions-runner

WORKDIR /home/runner/actions-runner

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 scripts/generate-installation-token.sh /usr/local/bin/generate-installation-token.sh
COPY --chmod=0755 scripts/register-and-run.sh /usr/local/bin/register-and-run.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD docker info >/dev/null 2>&1 && pgrep -f Runner.Listener >/dev/null 2>&1 || pgrep -f dockerd >/dev/null 2>&1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
