diff --git a/src/Misc/externals.sh b/src/Misc/externals.sh
index 4330017..9851b9c 100755
--- a/src/Misc/externals.sh
+++ b/src/Misc/externals.sh
@@ -187,3 +187,11 @@ fi
 if [[ "$PACKAGERUNTIME" == "linux-arm" ]]; then
     acquireExternalTool "$NODE_URL/v${NODE20_VERSION}/node-v${NODE20_VERSION}-linux-armv7l.tar.gz" node20 fix_nested_dir
 fi
+
+# musl (Alpine) host: use the Alpine-built node tarballs directly as the
+# runner's own node20/node24 (not just the node20_alpine/node24_alpine
+# fallback used for Alpine *job containers* on a glibc host).
+if [[ "$PACKAGERUNTIME" == "linux-musl-x64" ]]; then
+    acquireExternalTool "$NODE_ALPINE_URL/v${NODE20_VERSION}/node-v${NODE20_VERSION}-alpine-x64.tar.gz" node20
+    acquireExternalTool "$NODE_ALPINE_URL/v${NODE24_VERSION}/node-v${NODE24_VERSION}-alpine-x64.tar.gz" node24
+fi
diff --git a/src/Misc/layoutroot/config.sh b/src/Misc/layoutroot/config.sh
index 14cc6ba..318037c 100755
--- a/src/Misc/layoutroot/config.sh
+++ b/src/Misc/layoutroot/config.sh
@@ -51,12 +51,25 @@ then
         LDCONFIG_COMMAND="ldconfig"
     fi
 
-    libpath=${LD_LIBRARY_PATH:-}
-    $LDCONFIG_COMMAND -NXv ${libpath//:/ } 2>&1 | grep libicu >/dev/null 2>&1
-    if [ $? -ne 0 ]; then
-        echo "Libicu's dependencies is missing for Dotnet Core 6.0"
-        echo $message
-        exit 1
+    # musl (Alpine) doesn't populate an ldconfig cache the way glibc does, so
+    # `ldconfig -NXv | grep libicu` is always a false negative here even when
+    # icu-libs is installed. Detect musl via `ldd --version` and instead
+    # confirm libicu is resolvable directly, matching how it's actually
+    # loaded at runtime.
+    if ldd --version 2>&1 | grep -qi musl; then
+        if ! ldconfig -p 2>/dev/null | grep -qi libicu && ! find /usr/lib /lib -maxdepth 1 -name 'libicu*.so*' 2>/dev/null | grep -q .; then
+            echo "Libicu's dependencies is missing for Dotnet Core 6.0"
+            echo $message
+            exit 1
+        fi
+    else
+        libpath=${LD_LIBRARY_PATH:-}
+        $LDCONFIG_COMMAND -NXv ${libpath//:/ } 2>&1 | grep libicu >/dev/null 2>&1
+        if [ $? -ne 0 ]; then
+            echo "Libicu's dependencies is missing for Dotnet Core 6.0"
+            echo $message
+            exit 1
+        fi
     fi
 fi
 
